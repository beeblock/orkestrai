{
  "name": "orkestrai",
  "version": "0.22.0",
  "description": "A visual canvas for orchestrating multidisciplinary teams of AI agents.",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "https://orkestrai.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beeblock/orkestrai.git"
  },
  "bugs": {
    "url": "https://github.com/beeblock/orkestrai/issues"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "patch-package",
    "start": "node scripts/orkestrai-server.mjs",
    "migrate": "npx svelar migrate",
    "migrate:agent-room-data": "node scripts/import-agent-room-sqlite.mjs",
    "migrate:rollback": "npx svelar migrate --rollback",
    "migrate:refresh": "npx svelar migrate --refresh",
    "seed": "npx svelar seed:run",
    "dev:worker": "node scripts/svelar-dev-runtime.mjs queue:work --queue=default",
    "dev:scheduler": "node scripts/svelar-dev-runtime.mjs schedule:run",
    "relay:dev": "node packages/orkestrai-relay/src/server.mjs",
    "test:prepare": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --silent && svelte-kit sync",
    "test": "npm run test:prepare && vitest run",
    "test:watch": "npm run test:prepare && vitest",
    "test:e2e": "playwright test",
    "test:coverage": "npm run test:prepare && vitest run --coverage",
    "benchmark:code-graph": "npm run test:prepare && vitest run --config vitest.code-graph.config.ts",
    "ui:install": "npm exec --package shadcn-svelte@latest -- shadcn-svelte add --all --yes && npm install --save-prod @internationalized/date@^3.12.2 bits-ui@^2.18.1 embla-carousel-svelte@^8.6.0 formsnap@^2.0.1 layerchart@^2.0.0-next.48 mode-watcher@^1.1.0 paneforge@^1.0.2 svelte-sonner@^1.1.1 sveltekit-superforms@^2.30.1 tailwind-variants@^3.2.2 typebox@^1.1.39 vaul-svelte@^1.0.0-next.7 zod-v3-to-json-schema@^4.0.0",
    "electron:dev": "npm run build && electron .",
    "electron:start": "electron .",
    "electron:rebuild": "electron-rebuild -f -o better-sqlite3",
    "package:mac": "NODE_OPTIONS=--max-old-space-size=8192 npm run build && bash scripts/package-macos.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electron/rebuild": "^4.2.0",
    "@inlang/paraglide-js": "^2.24.1",
    "@lucide/svelte": "^1.34.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/table-core": "^8.21.3",
    "@types/pdfkit": "^0.17.6",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "electron": "^42.10.0",
    "electron-builder": "^26.15.3",
    "openapi-types": "^12.1.3",
    "patch-package": "^8.0.1",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/s3-request-presigner": "^3.1117.0",
    "@babel/parser": "^7.29.8",
    "@beeblock/svelar": "^0.7.9",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@internationalized/date": "^3.12.3",
    "@lezer/highlight": "^1.2.3",
    "@postman/tough-cookie": "^4.1.3-postman.1",
    "@readme/openapi-parser": "^7.0.1",
    "@tanstack/svelte-virtual": "^3.13.36",
    "@types/dompurify": "^3.2.0",
    "@usebruno/filestore": "^0.11.0",
    "@usebruno/js": "^0.50.0",
    "@usebruno/requests": "^0.19.0",
    "@vscode/ripgrep": "^1.18.0",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/svelte": "^1.6.3",
    "@yume-chan/adb": "^2.6.2",
    "@yume-chan/adb-scrcpy": "^2.3.2",
    "@yume-chan/adb-server-node-tcp": "^2.5.2",
    "@yume-chan/async": "^4.1.3",
    "@yume-chan/event": "^2.0.0",
    "@yume-chan/no-data-view": "^2.0.0",
    "@yume-chan/scrcpy": "^2.3.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "^2.5.3",
    "@yume-chan/stream-extra": "^2.6.1",
    "@yume-chan/struct": "^2.3.2",
    "better-sqlite3": "^12.11.1",
    "bits-ui": "^2.18.1",
    "bullmq": "^5.81.3",
    "chokidar": "^4.0.3",
    "clsx": "^2.1.0",
    "cm6-graphql": "^0.2.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.14",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "embla-carousel-svelte": "^8.6.0",
    "fast-xml-parser": "^5.11.0",
    "formsnap": "^2.0.1",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "https-proxy-agent": "^7.0.6",
    "ioredis": "^5.0.0",
    "layerchart": "^2.2.0",
    "marked": "^18.0.11",
    "meilisearch": "^0.60.0",
    "mode-watcher": "^1.1.0",
    "monaco-editor": "^0.56.0",
    "mysql2": "^3.23.3",
    "node-pty": "^1.1.0",
    "openapi-sampler": "^1.7.4",
    "paneforge": "^1.0.2",
    "parse5": "^8.0.1",
    "pdfjs-dist": "^6.2.108",
    "pdfkit": "^0.19.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "polygon-clipping": "^0.15.7",
    "postcss": "^8.5.26",
    "postgres": "^3.4.5",
    "postman-collection": "^5.3.1",
    "postman-runtime": "^7.56.1",
    "prettier": "^3.9.6",
    "qrcode": "^1.5.4",
    "quickjs-emscripten": "^0.32.0",
    "serve-sim": "0.1.45",
    "sherpa-onnx-node": "^1.13.6",
    "sigma": "^3.0.3",
    "smol-toml": "1.8.0",
    "svelte-sonner": "^1.2.1",
    "sveltekit-superforms": "^2.30.2",
    "svg-pathdata": "^7.2.0",
    "tailwind-merge": "^3.0.0",
    "tailwind-variants": "^3.3.1",
    "tough-cookie": "^6.0.2",
    "tw-animate-css": "^1.2.0",
    "typebox": "^1.3.19",
    "undici": "^7.29.0",
    "valibot": "^1.4.1",
    "vaul-svelte": "^1.0.0-next.7",
    "web-tree-sitter": "^0.27.0",
    "ws": "^8.21.3",
    "zod": "^3.25.0",
    "zod-v3-to-json-schema": "^4.0.0"
  },
  "overrides": {
    "axios": "1.19.0",
    "cookie": "^0.7.2",
    "dompurify": "$dompurify",
    "nanoid": "3.3.18",
    "qs": "6.15.3",
    "uuid": "11.1.1"
  },
  "main": "electron/main.cjs",
  "workspaces": [
    "packages/*"
  ],
  "build": {
    "appId": "com.orkestrai.desktop",
    "productName": "Orkestrai",
    "protocols": [
      {
        "name": "Orkestrai Collaboration",
        "schemes": [
          "orkestrai"
        ]
      }
    ],
    "icon": "electron/resources/icon.png",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**",
      "electron/**",
      "scripts/orkestrai-server.mjs",
      "scripts/install-orkestrai-shim.mjs",
      "src/lib/database/migrations/**",
      "src/lib/modules/agent-room/infrastructure/pty/**",
      "src/lib/modules/agent-room/infrastructure/voice/**",
      "src/lib/modules/agent-room/infrastructure/agent-path.ts",
      "src/lib/modules/agent-room/infrastructure/codex-mcp-config.ts",
      "src/lib/modules/agent-room/infrastructure/WslRuntime.ts",
      "src/lib/modules/agent-room/domain/runtime.ts",
      "packages/orkestrai-cli/**",
      "packages/orkestrai-figma-plugin/**",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json",
      "!node_modules/@tabler/**/*",
      "!node_modules/@xterm/**/*",
      "!node_modules/@codemirror/**/*",
      "!node_modules/@lezer/**/*",
      "!node_modules/codemirror/**/*",
      "!node_modules/@xyflow/**/*",
      "!node_modules/layerchart/**/*",
      "!node_modules/bits-ui/**/*",
      "!node_modules/pusher-js/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "electron/resources/icon.icns",
      "extraResources": [
        {
          "from": "electron/resources/macos-locales/en.lproj",
          "to": "en.lproj"
        },
        {
          "from": "electron/resources/macos-locales/pt-BR.lproj",
          "to": "pt-BR.lproj"
        },
        {
          "from": "electron/resources/macos-locales/es.lproj",
          "to": "es.lproj"
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Orkestrai uses the microphone only when you start voice dictation.",
        "NSDownloadsFolderUsageDescription": "Orkestrai needs access to projects you choose inside Downloads.",
        "NSDocumentsFolderUsageDescription": "Orkestrai needs access to projects you choose inside Documents.",
        "NSDesktopFolderUsageDescription": "Orkestrai needs access to projects you choose on the Desktop."
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "icon": "electron/resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Orkestrai"
    },
    "dmg": {
      "background": "electron/resources/dmg-background.png",
      "iconSize": 96,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 200,
          "type": "file"
        },
        {
          "x": 410,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "rpm"
      ],
      "maintainer": "Beeblock <11634143+rzeradev@users.noreply.github.com>",
      "category": "Development",
      "icon": "electron/resources/icons"
    },
    "rpm": {
      "artifactName": "${productName}-${version}.${arch}.${ext}",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libappindicator",
        "libsecret"
      ],
      "packageCategory": "Development/Tools",
      "compression": "xz"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "beeblock",
        "repo": "orkestrai"
      }
    ]
  }
}
