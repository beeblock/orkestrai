{
  "name": "orkestrai",
  "version": "0.1.3",
  "description": "A visual canvas for orchestrating teams of AI coding agents.",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "https://orkestrai.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beeblock/orkestrai.git"
  },
  "bugs": {
    "url": "https://github.com/beeblock/orkestrai/issues"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node scripts/orkestrai-server.mjs",
    "migrate": "npx svelar migrate",
    "migrate:agent-room-data": "node scripts/import-agent-room-sqlite.mjs",
    "migrate:rollback": "npx svelar migrate --rollback",
    "migrate:refresh": "npx svelar migrate --refresh",
    "seed": "npx svelar seed:run",
    "dev:worker": "node scripts/svelar-dev-runtime.mjs queue:work --queue=default",
    "dev:scheduler": "node scripts/svelar-dev-runtime.mjs schedule:run",
    "test": "svelte-kit sync && vitest run",
    "test:watch": "svelte-kit sync && vitest",
    "test:e2e": "playwright test",
    "test:coverage": "svelte-kit sync && vitest run --coverage",
    "ui:install": "npm exec --package shadcn-svelte@latest -- shadcn-svelte add --all --yes && npm install --save-prod @internationalized/date@^3.12.2 bits-ui@^2.18.1 embla-carousel-svelte@^8.6.0 formsnap@^2.0.1 layerchart@^2.0.0-next.48 mode-watcher@^1.1.0 paneforge@^1.0.2 svelte-sonner@^1.1.1 sveltekit-superforms@^2.30.1 tailwind-variants@^3.2.2 typebox@^1.1.39 vaul-svelte@^1.0.0-next.7 zod-v3-to-json-schema@^4.0.0",
    "electron:dev": "npm run build && electron .",
    "electron:start": "electron .",
    "electron:rebuild": "electron-rebuild -f -o better-sqlite3",
    "package:mac": "bash scripts/package-macos.sh"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@inlang/paraglide-js": "^2.23.1",
    "@lucide/svelte": "^1.28.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/table-core": "^9.0.0",
    "@types/ws": "^8.18.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@beeblock/svelar": "^0.7.7",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@internationalized/date": "^3.12.2",
    "@types/dompurify": "^3.0.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/svelte": "^1.6.2",
    "better-sqlite3": "^12.11.1",
    "bits-ui": "^2.18.1",
    "bullmq": "^5.0.0",
    "clsx": "^2.1.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.12",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "embla-carousel-svelte": "^8.6.0",
    "formsnap": "^2.0.1",
    "ioredis": "^5.0.0",
    "layerchart": "^2.0.4",
    "marked": "^18.0.7",
    "meilisearch": "^0.44.0",
    "mode-watcher": "^1.1.0",
    "mysql2": "^3.11.0",
    "node-pty": "^1.1.0",
    "paneforge": "^1.0.2",
    "pdfkit": "^0.18.0",
    "postgres": "^3.4.5",
    "sherpa-onnx-node": "^1.13.4",
    "svelte-sonner": "^1.1.1",
    "sveltekit-superforms": "^2.30.2",
    "tailwind-merge": "^3.0.0",
    "tailwind-variants": "^3.3.0",
    "tw-animate-css": "^1.2.0",
    "typebox": "^1.3.9",
    "valibot": "^1.4.1",
    "vaul-svelte": "^1.0.0-next.7",
    "ws": "^8.21.1",
    "zod": "^3.25.0",
    "zod-v3-to-json-schema": "^4.0.0"
  },
  "overrides": {
    "cookie": "^0.7.2"
  },
  "main": "electron/main.cjs",
  "workspaces": [
    "packages/*"
  ],
  "build": {
    "appId": "com.orkestrai.desktop",
    "productName": "Orkestrai",
    "icon": "electron/resources/icon.png",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**",
      "electron/**",
      "scripts/orkestrai-server.mjs",
      "scripts/install-orkestrai-shim.mjs",
      "src/lib/database/migrations/**",
      "src/lib/modules/agent-room/infrastructure/pty/**",
      "src/lib/modules/agent-room/infrastructure/voice/**",
      "src/lib/modules/agent-room/infrastructure/agent-path.ts",
      "packages/orkestrai-cli/**",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json",
      "!node_modules/@tabler/**/*",
      "!node_modules/@xterm/**/*",
      "!node_modules/@codemirror/**/*",
      "!node_modules/@lezer/**/*",
      "!node_modules/codemirror/**/*",
      "!node_modules/@xyflow/**/*",
      "!node_modules/layerchart/**/*",
      "!node_modules/bits-ui/**/*",
      "!node_modules/pusher-js/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "electron/resources/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "O Orkestrai usa o microfone para o ditado por voz nos terminais."
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "icon": "electron/resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Orkestrai"
    },
    "dmg": {
      "background": "electron/resources/dmg-background.png",
      "iconSize": 96,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 200,
          "type": "file"
        },
        {
          "x": 410,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "electron/resources/icons"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "beeblock",
        "repo": "orkestrai"
      }
    ]
  }
}
